PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mealmatch
SCRAPER_SERVICE_URL=http://localhost:8000
SCRAPER_TIMEOUT_MS=30000
CORS_ORIGIN=http://localhost:5173

# Nominatim (OpenStreetMap) reverse geocoding — no API key, but usage policy
# requires a descriptive User-Agent identifying the app/contact.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=MealMatchAI/1.0 (dev@localhost)

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
